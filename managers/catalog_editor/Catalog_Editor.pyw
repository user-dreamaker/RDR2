def shop_label(shop):
    return SHOP_NAMES.get(shop, 'Unidentified shop') + ' [' + shop + ']'


def money_text(cents):
    return '—' if cents is None else f'${cents // 100}.{cents % 100:02d}'


def parse_money(text):
    from decimal import Decimal
    text = text.strip().replace(',', '.').lstrip('$').strip()
    if not re.fullmatch(r'\d+(?:\.\d{1,2})?', text):
        raise ValueError('Enter a dollar amount with up to two decimal places.')
    cents = int(Decimal(text) * 100)
    if not 0 <= cents <= 2147483647:
        raise ValueError('Price is outside the supported range.')
    return cents


