}
CITY_LAYOUTS = {f'0x{item_hash(name):08X}': city for city,names in CITY_LAYOUT_NAMES.items() for name in names}
REGION_NAMES = {'0x0079B7EE':'Valentine','0xD3F2B8A7':'Rhodes','0x2A6CBBA2':'Saint Denis',
