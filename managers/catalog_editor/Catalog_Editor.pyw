        self.panel=ScrollGrid(self.root,[(90,0),(365,1),(130,0),(80,0),(200,0),(200,0)])
        self.stable_grid=self.panel.body
        for col,title,span in [(0,'In Stock',1),(1,'Horse',1),(2,'Price',1),(3,'Status',1),(4,'Original Availability*',1),(5,'Remove Mission Lock',1)]:
            ttk.Label(self.panel.header,text=title,style='StableHeader.TLabel',anchor='w' if col==1 else 'center').grid(row=0,column=col,columnspan=span,sticky='nsew')
        self._rows=[]; self._groups={}; self._unlock_checks={}
        self.location.trace_add('write',self.filter_rows); self.search.trace_add('write',self.filter_rows)

    def filter_rows(self,*_):
        q=self.search.get().strip().casefold(); loc=self.location.get(); visible=set()
        for sk, name, widgets in self._rows:
            city=STABLE_HORSES[sk]['name'].split(' - ')[0] if sk!='7_' else 'Tumbleweed'
            show=(loc=='All Locations' or loc==city) and q in name.casefold()
            for w in widgets: w.grid() if show else w.grid_remove()
            if show: visible.add(sk)
        for sk,w in self._groups.items(): w.grid() if sk in visible else w.grid_remove()
        self.panel.canvas.yview_moveto(0)

    def load_catalog(self, catalog, shop_model=None):
        self.shop_model=shop_model
        self._unlock_vars.clear()
        self._unlock_checks.clear(); self._rows.clear(); self._groups.clear()
        self.editor.load_catalog(catalog)
        for w in self.stable_grid.winfo_children():
            w.destroy()
        self._var_map.clear()
        self._price_vars.clear()
        self._price_entries.clear()
        self._status_labels.clear()
        self._backup.clear()
        self.initial_prices.clear()

        stable_cats = {"0x9C21E432", "0x6B6CCEAC"}
        self._by_hash = {}
        self._by_key = {}
        for item_node, key in self.editor.horse_items:
            cat = self.editor.get_category(item_node)
            if cat in stable_cats:
                hh = self.editor.get_horse_hash(item_node).upper()
                ik = self.editor.get_item_key(item_node)
                self._by_hash[hh] = (ik, item_node)
                self._by_key[ik] = (hh, item_node)

        total_present = 0
        total_count = 0
        group = self.stable_grid
        row = 0
        for stable_key in sorted(STABLE_HORSES):
            stable = STABLE_HORSES[stable_key]
            stable_name = stable["name"]
            stable_horses = stable["horses"]

            header = ttk.Label(group, text=stable_name, style="StableGroup.TLabel")
            header.grid(row=row, column=0, columnspan=6, sticky="ew", pady=(2, 0))
            self._groups[stable_key]=header
            row += 1

            for hh, (item_name, desc, price_dollars, chapter) in stable_horses.items():
                before=set(group.winfo_children())
                hh_upper = hh.upper()
                horse_name = HASH_TO_NAME.get(hh_upper, desc)
                in_ymt = hh_upper in self._by_hash
                is_present = in_ymt

                var = tk.BooleanVar(value=is_present)
                self._var_map[(stable_key, hh)] = var

                chk = ttk.Checkbutton(group, variable=var, style="Stable.TCheckbutton",
                                      command=lambda sk=stable_key, h=hh: self._on_toggle(sk, h))
                chk.grid(row=row, column=0, pady=3)

                name_label = ttk.Label(group, text=horse_name, style="Stable.TLabel")
                name_label.grid(row=row, column=1, sticky=tk.W, padx=8, pady=3)

                # Price column (editable)
                pvar = tk.StringVar()
                if is_present and hh_upper in self._by_hash:
                    _, node = self._by_hash[hh_upper]
                    cents = self.editor.get_price(node)
                    if cents:
                        try:
                            pvar.set(str(int(cents) // 100))
                        except ValueError:
                            pvar.set(str(price_dollars))
                    else:
                        pvar.set(str(price_dollars))
                else:
                    pvar.set(str(price_dollars))
                self._price_vars[(stable_key, hh)] = pvar
                self.initial_prices[(stable_key, hh)] = pvar.get()

                price_frame=ttk.Frame(group); price_frame.grid(row=row,column=2,pady=3)
                ttk.Label(price_frame, text="$", style="Stable.TLabel", foreground="#bfb0a4").pack(side="left",padx=(0,4))
                price_entry = ttk.Entry(price_frame, textvariable=pvar, width=9, style="Stable.TEntry")
                price_entry.pack(side="left")
                if not is_present:
                    price_entry.config(state='disabled')
                self._price_entries[(stable_key, hh)] = price_entry

                stext = "OK" if is_present else "Removed"
                fg = "#e6d6c7" if is_present else "#ff8585"
                status_label = ttk.Label(group, text=stext, style="Stable.TLabel", foreground=fg)
                status_label.grid(row=row, column=3, padx=5)
                self._status_labels[(stable_key, hh)] = status_label
                availability = chapter or 'Unknown'
                ttk.Label(group,text=availability,style='Stable.TLabel').grid(row=row,column=4,padx=4)
                key=None
                if in_ymt and self.shop_model:
                    key=self.shop_model.horse_key(int(self._by_hash[hh_upper][0],16))
                eligible=bool(key and self.shop_model.can_unlock_horse(key))
                if eligible:
                    uv=tk.BooleanVar(value=key in self.shop_model.unlocked)
                    self._unlock_vars[(stable_key,hh)]=(uv,key)
                    check=ttk.Checkbutton(group,variable=uv,style='Stable.TCheckbutton',command=lambda k=key,v=uv:self.horse_unlock(k,v))
                    check.grid(row=row,column=5,pady=3)
                    self._unlock_checks[(stable_key,hh)]=check
                else:
                    ttk.Label(group,text='—',style='Stable.TLabel',foreground='#82766b').grid(row=row,column=5,pady=3)
                self._rows.append((stable_key,horse_name,[w for w in group.winfo_children() if w not in before]))

                if is_present:
                    total_present += 1
                total_count += 1
                row += 1

        self.status.config(text=f"Loaded: {total_present}/{total_count} horses present  |  {len(self._unlock_vars)} eligible for Chapter 2  |  Checkbox sets Chapter 2 requirement; other game locks may remain." + ("  |  No late checks found: verify Vanilla backup." if not self._unlock_vars else ""))
        self.filter_rows()

    def horse_unlock(self,key,var):
        if key and self.shop_model: self.shop_model.set_unlock([key],var.get()); self.on_change()

    def sync_unlock(self):
        for var,key in self._unlock_vars.values(): var.set(bool(key and self.shop_model and key in self.shop_model.unlocked))

    def render(self, data):
        overrides = {}
        for row, price in self._price_vars.items():
            if price.get() == self.initial_prices[row] or not self._var_map[row].get():
                continue
            horse = row[1].upper()
            _, node = self._by_hash[horse]
            try:
                cents = int(price.get().strip()) * 100
            except ValueError:
                raise ValueError(f"Enter a whole-dollar price for {HASH_TO_NAME[horse]}.")
            if not 0 <= cents <= 2147483647:
                raise ValueError(f"Enter a price between $0 and $21474836 for {HASH_TO_NAME[horse]}.")
            node = deepcopy(node)
            if not self.editor.set_price(node, str(cents)):
                raise ValueError(f"Could not set the cash price for {HASH_TO_NAME[horse]}.")
            overrides[node.get_attr("key")] = node
        return self.editor.render(data, overrides)

    def _on_toggle(self, stable_key, hh):
        hh_upper = hh.upper()
        var = self._var_map.get((stable_key, hh))
        if var is None:
            return
        if var.get():
            self._restore(hh_upper)
        else:
            self._remove(hh_upper)
        entry = self._price_entries.get((stable_key, hh))
        if entry:
            entry.config(state='normal' if var.get() else 'disabled')
        self._update_row_label(stable_key, hh)
        key=(stable_key,hh)
        if key in self._unlock_checks:
            check=self._unlock_checks[key]
            check.state(["!disabled" if var.get() else "disabled"])
            if not var.get():
                uv,stock_key=self._unlock_vars[key]; uv.set(False); self.horse_unlock(stock_key,uv)

    def _update_row_label(self, stable_key, hh):
        var = self._var_map.get((stable_key, hh))
        if var is None:
            return
        lbl = self._status_labels.get((stable_key, hh))
        if lbl is None:
            return
        is_present = var.get()
        lbl.config(text="OK" if is_present else "Removed",
                   foreground="#e6d6c7" if is_present else "#ff8585")

    def _remove(self, hh_upper):
        if hh_upper in self._by_hash:
            ik, node = self._by_hash[hh_upper]
            xml_backup = node.to_string()
            removed = self.editor.remove_item_by_key(ik)
            if removed:
                self._backup[hh_upper] = {'key': ik, 'xml': xml_backup}
                del self._by_hash[hh_upper]
                if ik in self._by_key:
                    del self._by_key[ik]
                name = HASH_TO_NAME.get(hh_upper, hh_upper)
                self.status.config(text=f"Removed: {name}")
            else:
                self.status.config(text=f"Failed to remove {hh_upper}")
                self._set_checkbox(hh_upper, True)
        elif hh_upper in self._backup:
            self.status.config(text="Already removed")
        else:
            self.status.config(text=f"Not found in YMT: {hh_upper}")
            self._set_checkbox(hh_upper, True)

    def _restore(self, hh_upper):
        if hh_upper not in self._backup:
            self.status.config(text=f"No backup for {hh_upper}")
            self._set_checkbox(hh_upper, False)
            return
        data = self._backup[hh_upper]
        xml_str = data['xml']
        try:
            temp_doc = YMTDocument()
            temp_doc.parse(xml_str)
            if temp_doc.root is None:
                raise ValueError("Empty root")
            restored = temp_doc.root
            if self.editor.restore_item(restored):
                ik = restored.get_attr('key')
                self._by_hash[hh_upper] = (ik, restored)
                self._by_key[ik] = (hh_upper, restored)
                del self._backup[hh_upper]
                name = HASH_TO_NAME.get(hh_upper, hh_upper)
                self.status.config(text=f"Restored: {name}")
            else:
                self.status.config(text="Restore failed (container not found)")
                self._set_checkbox(hh_upper, False)
        except Exception as e:
            self.status.config(text=f"Restore error: {e}")
            self._set_checkbox(hh_upper, False)

    def _set_checkbox(self, hh_upper, value):
        for (sk, hh), var in self._var_map.items():
            if hh.upper() == hh_upper:
                var.set(value)
                return


