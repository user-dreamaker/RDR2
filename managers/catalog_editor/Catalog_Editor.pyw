class ScrollGrid:
    """A responsive grid with fixed column headings and a scrollable body."""
    def __init__(self, parent, columns):
        frame=ttk.Frame(parent, style='Filter.TFrame', padding=1)
        frame.pack(fill='both', expand=True, padx=12, pady=(3,8))
        self.header=ttk.Frame(frame); self.header.grid(row=0,column=0,sticky='ew')
        self.canvas=tk.Canvas(frame,background='#090807',highlightthickness=0,borderwidth=0)
        self.canvas.grid(row=1,column=0,sticky='nsew')
        sb=ttk.Scrollbar(frame,orient='vertical',command=self.canvas.yview)
        sb.grid(row=1,column=1,sticky='ns'); self.canvas.configure(yscrollcommand=sb.set)
        frame.columnconfigure(0,weight=1); frame.rowconfigure(1,weight=1)
        self.body=ttk.Frame(self.canvas,style='Stable.TFrame')
        self.window=self.canvas.create_window(0,0,anchor='nw',window=self.body)
        for c,(minimum,weight) in enumerate(columns):
            for grid in (self.header,self.body): grid.columnconfigure(c,minsize=minimum,weight=weight)
        self.body.bind('<Configure>',lambda e:self.canvas.configure(scrollregion=self.canvas.bbox('all')))
        self.canvas.bind('<Configure>',lambda e:self.canvas.itemconfigure(self.window,width=e.width))
        parent.winfo_toplevel().bind('<MouseWheel>',self.wheel,add='+')
        parent.winfo_toplevel().bind('<Button-4>',self.wheel,add='+')
        parent.winfo_toplevel().bind('<Button-5>',self.wheel,add='+')
    def wheel(self,event):
        widget=event.widget
        while widget is not None:
            if widget in (self.canvas,self.body):
                n=-1 if getattr(event,'num',None)==4 else 1 if getattr(event,'num',None)==5 else -int(event.delta/120) or (-1 if event.delta>0 else 1)
                self.canvas.yview_scroll(n,'units'); return 'break'
            widget=getattr(widget,'master',None)


