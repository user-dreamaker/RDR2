class YMTNode:
    def __init__(self, name, attributes=None, text=None):
        self.name = name
        self.attributes = OrderedDict(attributes) if attributes else OrderedDict()
        self.children = []
        self.text = text
        self.parent = None

    def add_child(self, node):
        node.parent = self
        self.children.append(node)

    def get_child_by_name(self, name):
        for c in self.children:
            if c.name == name:
                return c
        return None

    def get_children_by_name(self, name):
        return [c for c in self.children if c.name == name]

    def get_attr(self, key, default=None):
        return self.attributes.get(key, default)

    NEWLINE = "\r\n"

    def to_string(self, indent=0):
        pad = "  " * indent
        attrs = ""
        if self.attributes:
            attrs = " " + " ".join(f'{k}="{v}"' for k, v in self.attributes.items())
        nl = self.NEWLINE
        if self.text is not None:
            return f"{pad}<{self.name}{attrs}>{self.text}</{self.name}>{nl}"
        if not self.children:
            return f"{pad}<{self.name}{attrs}/>{nl}"
        lines = [f"{pad}<{self.name}{attrs}>{nl}"]
        for child in self.children:
            if isinstance(child, YMTNode):
                lines.append(child.to_string(indent + 1))
            else:
                lines.append(f"{pad}  {child}{nl}")
        lines.append(f"{pad}</{self.name}>{nl}")
        return "".join(lines)


class YMTDocument:
    def __init__(self):
        self.root = None

    def parse(self, text):
        self.original_text = text
        self.root = self._parse_element(text, 0)[0]

    def _parse_element(self, text, pos):
        tag_start = text.find('<', pos)
        if tag_start == -1:
            return None, pos
        if text[tag_start+1] == '/':
            return None, text.find('>', tag_start) + 1
        tag_end = text.find('>', tag_start)
        if tag_end == -1:
            return None, pos
        tag_content = text[tag_start+1:tag_end]
        if tag_content.endswith('/'):
            clean = tag_content[:-1].strip()
            name_end = self._find_name_end(clean)
            name = clean[:name_end].strip()
            attr_str = clean[name_end:].strip()
            attrs = self._parse_attributes(attr_str)
            node = YMTNode(name, attrs)
            return node, tag_end + 1
        name_end = self._find_name_end(tag_content)
        name = tag_content[:name_end].strip()
        attr_str = tag_content[name_end:].strip()
        attrs = self._parse_attributes(attr_str)
        node = YMTNode(name, attrs)
        pos = tag_end + 1
        while pos < len(text):
            if text[pos] == '<':
                if text[pos+1] == '/':
                    close_end = text.find('>', pos)
                    close_tag = text[pos+2:close_end].strip()
                    if close_tag == name:
                        return node, close_end + 1
                    pos = close_end + 1
                    continue
                else:
                    child, pos = self._parse_element(text, pos)
                    if child is not None:
                        node.add_child(child)
                    continue
            else:
                text_end = text.find('<', pos)
                if text_end == -1:
                    break
                content = text[pos:text_end].strip()
                if content and not node.children:
                    node.text = content
                pos = text_end
        return node, pos

    def _find_name_end(self, s):
        i = 0
        while i < len(s) and not s[i].isspace():
            i += 1
        return i

    def _parse_attributes(self, s):
        attrs = OrderedDict()
        if not s:
            return attrs
        for match in re.finditer(r'(\S+)\s*=\s*"([^"]*)"', s):
            attrs[match.group(1)] = match.group(2)
        return attrs

    def to_string(self):
        if self.root:
            return self.root.to_string(0)
        return ""

    def get_all_items(self):
        items = []
        self._collect_items(self.root, items)
        return items

    def _collect_items(self, node, items):
        if node.name == 'Item' and 'key' in node.attributes:
            items.append(node)
        for child in node.children:
            self._collect_items(child, items)


class CatalogEditor:
    def __init__(self):
        self.doc = None
        self.filepath = ""
        self.horse_items = []

    def load_catalog(self, catalog):
        self.horse_items = []
        self.horse_records = {}
        models = set(HASH_TO_NAME)
        for item_id, (start, end) in catalog.records.items():
            data = catalog.data[start:end]
            if b"<UNK_MEMBER_0x6C42F444>" not in data:
                continue
            match = re.search(rb"<UNK_MEMBER_0x6C42F444>(0x[0-9a-fA-F]{8})</", data)
            if not match or match[1].decode("ascii").upper() not in models:
                continue
            doc = YMTDocument()
            doc.parse(data.decode("utf-8"))
            node = doc.root
            if self.get_category(node) not in {"0x9C21E432", "0x6B6CCEAC"}:
                continue
            key = node.get_attr("key")
            self.horse_items.append((node, key))
            self.horse_records[key] = (start, end, node.to_string())

    def get_horse_hash(self, item_node):
        return self._get_node_text(item_node, "UNK_MEMBER_0x6C42F444")

    def get_category(self, item_node):
        return self._get_node_text(item_node, "category")

    def get_item_key(self, item_node):
        return item_node.get_attr("key")

    def remove_item_by_key(self, item_key):
        for index, (node, key) in enumerate(self.horse_items):
            if key == item_key:
                self.horse_items.pop(index)
                return node
        return None

    def restore_item(self, item_node):
        self.horse_items.append((item_node, item_node.get_attr("key")))
        return True

    def render(self, data, overrides=None):
        nodes = dict((key, node) for node, key in self.horse_items)
        nodes.update(overrides or {})
        parts, position = [], 0
        for key, (start, end, original) in sorted(self.horse_records.items(), key=lambda item: item[1][0]):
            node = nodes.get(key)
            updated = node.to_string() if node is not None else ""
            if updated == original:
                continue
            parts.append(data[position:start])
            if updated:
                updated = updated.rstrip("\r\n")
                if b"\r\n" not in data[start:end]:
                    updated = updated.replace("\r\n", "\n")
                indent = data[data.rfind(b"\n", 0, start) + 1:start]
                if not indent.strip():
                    updated = updated.encode("utf-8").replace(b"\n", b"\n" + indent)
                else:
                    updated = updated.encode("utf-8")
                parts.append(updated)
            position = end
        parts.append(data[position:])
        return b"".join(parts)

    def _cash_price_node(self, item_node):
        costs = item_node.get_child_by_name('UNK_MEMBER_0x4F728F50')
        if costs is None:
            return None
        is_bonus = item_node.get_attr('key', '').upper() in BONUS_HORSE_KEYS
        for cost in costs.get_children_by_name('Item'):
            if is_bonus and self._get_node_text(cost, 'UNK_MEMBER_0xE9806307').upper() != '0XC96FEC6B':
                continue
            items = cost.get_child_by_name('UNK_MEMBER_0xC53812FF')
            if items is None:
                continue
            for payment in items.get_children_by_name('Item'):
                if is_bonus and self._get_node_text(payment, 'UNK_MEMBER_0xD3B360C4').upper() != '0X7C407083':
                    continue
                value = payment.get_child_by_name('UNK_MEMBER_0x9EA8B8F4')
                if value is not None:
                    return value
                if 'value' in payment.attributes:
                    return payment
        return None

    def get_price(self, item_node):
        node = self._cash_price_node(item_node)
        return node.get_attr('value', '') if node is not None else ''

    def set_price(self, item_node, price_cents_str):
        node = self._cash_price_node(item_node)
        if node is not None:
            node.attributes['value'] = price_cents_str
            return True
        if item_node.get_attr('key', '').upper() not in BONUS_HORSE_KEYS:
            return False
        if price_cents_str == '0':
            return True

        costs = item_node.get_child_by_name('UNK_MEMBER_0x4F728F50')
        if costs is None:
            costs = YMTNode('UNK_MEMBER_0x4F728F50')
            sellprices = item_node.get_child_by_name('UNK_MEMBER_0x1B8108CB')
            if sellprices is None:
                return False
            costs.parent = item_node
            item_node.children.insert(item_node.children.index(sellprices), costs)
        if any(self._get_node_text(cost, 'UNK_MEMBER_0xE9806307').upper() == '0XC96FEC6B'
               for cost in costs.get_children_by_name('Item')):
            return False

        cost = YMTNode('Item')
        cost.add_child(YMTNode('UNK_MEMBER_0xE9806307', text='0xC96FEC6B'))
        cost.add_child(YMTNode('UNK_MEMBER_0x9EA8B8F4', {'value': '1'}))
        cost.add_child(YMTNode('UNK_MEMBER_0xEBB42AC3', text='0x537EE473'))
        items = YMTNode('UNK_MEMBER_0xC53812FF')
        payment = YMTNode('Item')
        payment.add_child(YMTNode('UNK_MEMBER_0xD3B360C4', text='0x7C407083'))
        payment.add_child(YMTNode('UNK_MEMBER_0x9EA8B8F4', {'value': price_cents_str}))
        items.add_child(payment)
        cost.add_child(items)
        cost.add_child(YMTNode('UNK_MEMBER_0xD7010B19'))
        costs.add_child(cost)
        return True

    def _get_node_text(self, node, name):
        child = node.get_child_by_name(name)
        if child is None:
            return ""
        if child.text is not None:
            return child.text
        return ""

