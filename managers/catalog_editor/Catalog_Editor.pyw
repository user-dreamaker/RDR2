                '0x0A8B2CBE':'Annesburg','0x0D912E67':'Tumbleweed','0x2A8A710C':'Scarlett Meadows'}
REQ_TAG = b'UNK_MEMBER_0xDB776875'
REQ_LIST = re.compile(rb'<' + REQ_TAG + rb'>(.*?)</' + REQ_TAG + rb'>', re.S)
REQ_ITEM = re.compile(rb'<Item>\s*<type>(0x[0-9A-Fa-f]{8})</type>\s*<UNK_MEMBER_0xE9806307>(0x[0-9A-Fa-f]{8})</UNK_MEMBER_0xE9806307>.*?</Item>', re.S)

# Exact progression replacement verified against Vanilla and Modded catalog_sp.ymt.
HORSE_STOCK_TYPE = '0xAAB38B41'
HORSE_LATE_REQUIREMENTS = {
    (b'0xD29E7F84', b'0xFD19B500'),
    (b'0xD29E7F84', b'0xF2C1A174'),
    (b'0xD29E7F84', b'0x9BB2F488'),
    (b'0x8C2CCEEF', b'0xEF83412D'),
}
HORSE_CH2_REQUIREMENT = (b'0x8C2CCEEF', b'0x38E0C39B')

def unlock_horse_ch2(raw):
    def replace_list(block):
        def replace_condition(m):
            if (m[1], m[2]) not in HORSE_LATE_REQUIREMENTS:
                return m[0]
            # Change only the two captured values; preserve formatting and flags.
            a,b=m.start(1)-m.start(),m.end(1)-m.start()
            c,d=m.start(2)-m.start(),m.end(2)-m.start()
            return m[0][:a]+HORSE_CH2_REQUIREMENT[0]+m[0][b:c]+HORSE_CH2_REQUIREMENT[1]+m[0][d:]
        return block[0][:block.start(1)-block.start()]+REQ_ITEM.sub(replace_condition,block[1])+block[0][block.end(1)-block.start():]
    return REQ_LIST.sub(replace_list,raw)


class ShopData:
    def __init__(self, catalog):
        self.catalog = catalog
        self.stock = {}  # (shop hash, item ID) -> original byte range
        self.info = {}   # item ID -> (name, category, buy, sell, bundle quantity)
        self.fields = {} # (item ID, field) -> original byte range
        self.removed = set()
        self.changes = {}
        self.unlocked = set()
        self.locations = {}
        self.layout_rows = {}
        self.read_stock()
        for item_id in {i for _, i in self.stock}:
            self.read_item(item_id)
        self.read_locations()
        for key in self.stock:
            self.locations.setdefault(key,set())

    def read_locations(self):
        # A layout identifies display membership, not a separate price or stock record.
        import xml.etree.ElementTree as ET
        block=re.search(rb'<UNK_MEMBER_0x199CD35C>.*?</UNK_MEMBER_0x199CD35C>',self.catalog.data,re.S)
        if not block: return
        direct={}; links={}; types={}
        for layout in ET.fromstring(block[0]):
            lid=layout.findtext('UNK_MEMBER_0xCC34C8ED'); shop=layout.findtext('UNK_MEMBER_0x38E4FA9C')
            if not lid or not shop: continue
            rows=set(); refs=set()
            for entry in layout.findall('UNK_MEMBER_0x94C66E9F/Item/UNK_MEMBER_0xC53812FF/Item'):
                v=entry.findtext('UNK_MEMBER_0xE9806307')
                if v and HASH.fullmatch(v):
                    key=(shop,int(v,16))
                    if key in self.stock: rows.add(key)
                ref=entry.findtext('UNK_MEMBER_0x7D9E7571')
                if ref: refs.add(ref)
            direct[lid]=rows; links[lid]=refs; types[lid]=shop
        for lid,rows in direct.items():
            if not rows: continue
            city=CITY_LAYOUTS.get(lid)
            if city:
                # Follow actual catalog-page links into clothing/customization menus.
                seen=set(); todo=[lid]; rows=set()
                while todo:
                    ref=todo.pop()
                    if ref in seen or ref not in direct: continue
                    if ref in CITY_LAYOUTS and CITY_LAYOUTS[ref]!=city: continue
                    seen.add(ref); rows.update(direct[ref]); todo.extend(links[ref]-seen)
                for key in rows: self.locations.setdefault(key,set()).add(city)
            label=(city+' - ' if city else 'Shared / unidentified - ')+shop_label(types[lid])+' / '+lid
            self.layout_rows[label]=rows

    def horse_key(self, item_id):
        key=('0xAAB38B41',item_id)
        return key if key in self.stock else None

    def can_unlock_horse(self, key):
        if key[0] != HORSE_STOCK_TYPE or key not in self.stock or self.info.get(key[1], (None,None))[1] != 'Stable Manager':
            return False
        a,b=self.stock[key]
        raw=self.catalog.data[a:b]
        return unlock_horse_ch2(raw) != raw

    def set_unlock(self, keys, value):
        eligible={k for k in keys if self.can_unlock_horse(k)}
        if value: self.unlocked.update(eligible)
        else: self.unlocked.difference_update(eligible)
        return len(eligible)

    def read_stock(self):
        data = self.catalog.data
        m = re.search(rb'<UNK_MEMBER_0x82019A58>(.*?)</UNK_MEMBER_0x82019A58>', data, re.S)
        # This tag also occurs inside items; only the top-level block contains shops.
        if m is None or not m[1].lstrip().startswith(b'<Item>'):
            return
        fragment = m[0]
        p = expat.ParserCreate()
        stack = []
        shop = None
        item_id = None
        start = None
        chunks = []
        def begin(name, attrs):
            nonlocal start, item_id, shop
            stack.append(name)
            chunks.clear()
            if len(stack) == 2:
                shop = None
            if stack == ['UNK_MEMBER_0x82019A58','Item','UNK_MEMBER_0xC53812FF','Item']:
                start, item_id = p.CurrentByteIndex, None
        def chars(s):
            chunks.append(s)
        def end(name):
            nonlocal shop, item_id
            s = ''.join(chunks).strip()
            if stack == ['UNK_MEMBER_0x82019A58','Item','type'] and HASH.fullmatch(s):
                shop = '0x%08X' % int(s,16)
            elif stack == ['UNK_MEMBER_0x82019A58','Item','UNK_MEMBER_0xC53812FF','Item','UNK_MEMBER_0xD3B360C4'] and HASH.fullmatch(s):
                item_id = int(s,16)
            elif stack == ['UNK_MEMBER_0x82019A58','Item','UNK_MEMBER_0xC53812FF','Item'] and shop and item_id is not None:
                stop = fragment.find(b'>',p.CurrentByteIndex)+1
                a,b = m.start()+start,m.start()+stop
                # include indentation and newline only if they contain whitespace
                line = data.rfind(b'\n',0,a)+1
                if not data[line:a].strip():
                    a=line
                eol = data.find(b'\n',b)
                if eol>=0 and not data[b:eol].strip():
                    b=eol+1
                key=(shop,item_id)
                if key in self.stock:
                    raise ValueError('Duplicate shop inventory entry: '+str(key))
                self.stock[key]=(a,b)
            stack.pop()
            chunks.clear()
        p.StartElementHandler=begin; p.EndElementHandler=end; p.CharacterDataHandler=chars
        p.Parse(fragment,True)

    def read_item(self, item_id):
        name, category = SHOP_ITEM_NAMES.get(item_id, ('0x%08X'%item_id,'Unknown'))
        buy=sell=quantity=None
        span=self.catalog.records.get(item_id)
        if span:
            a,b=span; raw=self.catalog.data[a:b]
            cat=re.search(rb'<category>([^<]+)</category>',raw)
            cat_hash=cat[1].decode('ascii') if cat else ''
            if category=='Unknown' and cat_hash: category=cat_hash
            # Horse records remain owned by Stable Manager.
            if cat_hash not in {'0x9C21E432','0x6B6CCEAC'}:
                for field, tag, transaction in [('buy',b'UNK_MEMBER_0x4F728F50',b'0xC96FEC6B'),('sell',b'UNK_MEMBER_0x1B8108CB',b'0x30AA1CF3')]:
                    block=re.search(rb'<'+tag+rb'>(.*?)</'+tag+rb'>',raw,re.S)
                    if not block: continue
                    matches=[v for v in CASH_TRANSACTION.finditer(raw,block.start(1),block.end(1)) if v[1]==transaction]
                    # Do not edit if another transaction of the same type exists.
                    if len(matches)!=1 or block[1].count(transaction)!=1: continue
                    v=matches[0]; val=int(v[3]); qty=int(v[2]);
                    if not 0<=val<=2147483647 or not 1<=qty<=2147483647: continue
                    self.fields[item_id,field]=(a+v.start(3),a+v.end(3))
                    if field=='buy':
                        buy=val; quantity=qty
                        self.fields[item_id,'quantity']=(a+v.start(2),a+v.end(2))
                    else: sell=val
            else:
                model=re.search(rb'<UNK_MEMBER_0x6C42F444>([^<]+)</UNK_MEMBER_0x6C42F444>',raw)
                if model: name=HASH_TO_NAME.get(model[1].decode('ascii').upper(),name)
                category='Stable Manager'
        self.info[item_id]=(name,category,buy,sell,quantity)

    def value(self,item_id,field):
        return self.changes.get((item_id,field),self.info[item_id][{'buy':2,'sell':3,'quantity':4}[field]])

    def set_value(self,item_id,field,value):
        key=(item_id,field)
        if key not in self.fields: raise ValueError('No unambiguous cash field for this item.')
        if not (1 if field=='quantity' else 0)<=value<=2147483647: raise ValueError('Value out of range.')
        original=self.info[item_id][{'buy':2,'sell':3,'quantity':4}[field]]
        if value==original: self.changes.pop(key,None)
        else: self.changes[key]=value

    def render(self, changes=None, removed=None, unlocked=None):
        changes=self.changes if changes is None else changes
        removed=self.removed if removed is None else removed
        unlocked=self.unlocked if unlocked is None else unlocked
        patches=[]
        for key,value in changes.items():
            if key not in self.fields: raise ValueError('Shop price field no longer exists: '+str(key))
            a,b=self.fields[key]; patches.append((a,b,str(value).encode('ascii')))
        for key in removed:
            if key not in self.stock: raise ValueError('Shop stock entry no longer exists: '+str(key))
            a,b=self.stock[key]; patches.append((a,b,b''))
        for key in unlocked-removed:
            if key[0] != HORSE_STOCK_TYPE: continue
            if key not in self.stock: raise ValueError('Mission stock entry no longer exists: '+str(key))
            a,b=self.stock[key]; raw=self.catalog.data[a:b]
            edited=unlock_horse_ch2(raw)
            if raw!=edited: patches.append((a,b,edited))
        data=self.catalog.data; parts=[]; pos=0
        for a,b,v in sorted(patches):
            if a<pos: raise ValueError('Overlapping shop edits.')
            parts.extend((data[pos:a],v)); pos=b
        parts.append(data[pos:]); return b''.join(parts)


GUN_DISPLAY_NAMES = dict(zip(['WEAPON_REVOLVER_CATTLEMAN', 'WEAPON_REVOLVER_SCHOFIELD', 'WEAPON_REVOLVER_DOUBLEACTION', 'WEAPON_REVOLVER_LEMAT', 'WEAPON_PISTOL_VOLCANIC', 'WEAPON_PISTOL_MAUSER', 'WEAPON_PISTOL_SEMIAUTO', 'WEAPON_PISTOL_M1899', 'WEAPON_REPEATER_CARBINE', 'WEAPON_REPEATER_WINCHESTER', 'WEAPON_REPEATER_HENRY', 'WEAPON_REPEATER_EVANS', 'WEAPON_RIFLE_SPRINGFIELD', 'WEAPON_RIFLE_BOLTACTION', 'WEAPON_RIFLE_VARMINT', 'WEAPON_SHOTGUN_DOUBLEBARREL', 'WEAPON_SHOTGUN_PUMP', 'WEAPON_SHOTGUN_REPEATING', 'WEAPON_SHOTGUN_SEMIAUTO', 'WEAPON_SHOTGUN_SAWEDOFF', 'WEAPON_SNIPERRIFLE_ROLLINGBLOCK', 'WEAPON_SNIPERRIFLE_CARCANO'], ['Cattleman Revolver', 'Schofield Revolver', 'Double-Action Revolver', 'LeMat Revolver', 'Volcanic Pistol', 'Mauser Pistol', 'Semi-Automatic Pistol', 'M1899 Pistol', 'Carbine Repeater', 'Lancaster Repeater', 'Litchfield Repeater', 'Evans Repeater', 'Springfield Rifle', 'Bolt Action Rifle', 'Varmint Rifle', 'Double-Barreled Shotgun', 'Pump-Action Shotgun', 'Repeating Shotgun', 'Semi-Auto Shotgun', 'Sawed-Off Shotgun', 'Rolling Block Rifle', 'Carcano Rifle']))


GUN_CATEGORIES = ('All', 'Revolvers', 'Pistols', 'Repeaters', 'Rifles', 'Shotguns')
GUN_CATEGORY_BY_TYPE = {
    'REVOLVER': 'Revolvers', 'PISTOL': 'Pistols', 'REPEATER': 'Repeaters',
    'RIFLE': 'Rifles', 'SNIPERRIFLE': 'Rifles', 'SHOTGUN': 'Shotguns',
}



class GunsmithManager:
    def __init__(self, root):
        self.root=root; self.model=None
        self.category=tk.StringVar(value=GUN_CATEGORIES[0])
        self.search=tk.StringVar()
        self.status=tk.StringVar(); self.price_vars={}; self.keys=[]
        self.sort='name'; self.reverse=False; self.headings={}; self.visible=[]
        self.header = build_manager_header(root, "GUNSMITH MANAGER")
        bar=ttk.Frame(root,style='Filter.TFrame',padding=(10,7)); bar.pack(fill='x',padx=12,pady=(0,6))
        ttk.Label(bar,text='Category').pack(side='left',padx=(0,5))
        self.category_combo=ttk.Combobox(bar,textvariable=self.category,values=GUN_CATEGORIES,state='readonly',width=12)
        self.category_combo.pack(side='left',padx=(0,12))
        ttk.Label(bar,text='Search').pack(side='left',padx=(0,5))
        ttk.Entry(bar,textvariable=self.search,width=30).pack(side='left',padx=(0,8))
        ttk.Button(bar,text='Clear Filters',command=self.clear).pack(side='left')
        ttk.Label(root,textvariable=self.status,padding=(12,5),anchor='w').pack(side='bottom',fill='x')
        self.panel=ScrollGrid(root,[(280,1),(125,0)])
        for col,(key,title) in enumerate([('name','Weapon'),('buy','Buy Price')]):
            label=ttk.Label(self.panel.header,text=title,style='StableHeader.TLabel',anchor='w' if col==0 else 'e',padding=(0,0,8,0) if col else (0,0),cursor='hand2')
            label.grid(row=0,column=col,sticky='nsew'); label.bind('<Button-1>',lambda e,k=key:self.toggle_sort(k)); self.headings[key]=(label,title)
        self.category.trace_add('write',self.refresh)
        self.search.trace_add('write',self.refresh)

    def clear(self):
        self.category.set(GUN_CATEGORIES[0]); self.search.set('')

    def load(self,model):
        self.model=model; self.price_vars.clear()
        self.keys=[k for k in model.stock if k[0]=='0xDF9DCDB1' and model.info[k[1]][0] in GUN_DISPLAY_NAMES]
        for k in self.keys:
            i=k[1]; val=model.value(i,'buy')
            if val is not None:
                self.price_vars[i]=tk.StringVar(value=money_text(val)[1:])
                self.price_vars[i].trace_add('write',lambda *_,i=i:self.update_price(i))
        self.clear(); self.refresh()

    def name(self,k): return GUN_DISPLAY_NAMES[self.model.info[k[1]][0]]

    def weapon_category(self,k):
        return GUN_CATEGORY_BY_TYPE.get(self.model.info[k[1]][0].split('_',2)[1])

    def update_price(self,i):
        try: self.model.set_value(i,'buy',parse_money(self.price_vars[i].get()))
        except ValueError: pass  # Keep invalid input visible; save validates all values.

    def validate(self):
        for i,var in self.price_vars.items():
            try: self.model.set_value(i,'buy',parse_money(var.get()))
            except ValueError as e: raise ValueError(f'{GUN_DISPLAY_NAMES[self.model.info[i][0]]}: {e}') from e

    def toggle_sort(self,key):
        self.reverse=not self.reverse if self.sort==key else False; self.sort=key; self.refresh()

    def refresh(self,*_):
        if self.model is None: return
        query=self.search.get().strip().casefold(); category=self.category.get()
        self.visible=[k for k in self.keys if (category==GUN_CATEGORIES[0] or category==self.weapon_category(k)) and (query in self.name(k).casefold() or query in self.model.info[k[1]][0].casefold() or query in ('0x%08X'%k[1]).casefold())]
        def sortkey(k):
            if self.sort=='buy': return (self.model.value(k[1],'buy') is None,self.model.value(k[1],'buy') or 0,self.name(k).casefold())
            return self.name(k).casefold()
        self.visible.sort(key=sortkey,reverse=self.reverse)
        for key,(label,title) in self.headings.items(): label.configure(text=title+(' ▼' if self.reverse else ' ▲') if self.sort==key else title)
        body=self.panel.body
        for widget in body.winfo_children(): widget.destroy()
        for row,k in enumerate(self.visible):
            i=k[1]
            ttk.Label(body,text=self.name(k),style='Stable.TLabel',padding=(10,7)).grid(row=row*2,column=0,sticky='ew')
            if i in self.price_vars:
                price=ttk.Frame(body); price.grid(row=row*2,column=1,padx=(0,8),pady=4,sticky='e')
                ttk.Label(price,text='$').pack(side='left',padx=(0,4)); ttk.Entry(price,textvariable=self.price_vars[i],width=11,style='Stable.TEntry').pack(side='left')
            else: ttk.Label(body,text='—',foreground='#82766b').grid(row=row*2,column=1,padx=(0,8),sticky='e')
            ttk.Separator(body).grid(row=row*2+1,column=0,columnspan=2,sticky='ew')
        self.status.set(f'{len(self.visible)} weapons  |  Category: {category}')
        self.panel.canvas.yview_moveto(0)


class CatalogApp:
    def __init__(self, root):
        self.root = root
        self.source = Path(__file__).resolve().with_name("catalog_sp.bak")
        self.target = self.source.with_suffix(".ymt")
        self.saved_data = None
        root.title(TITLE)
        root.geometry("1060x650")
        root.minsize(1120, 610)
        try:
            root.state("zoomed")
        except tk.TclError:
            try:
                root.attributes("-zoomed", True)
            except tk.TclError:
                pass

        toolbar = ttk.Frame(root, padding=(12, 4))
        toolbar.pack(fill="x")
        self.status = tk.StringVar(value="Loading catalog_sp.bak…")
        ttk.Label(toolbar, textvariable=self.status).pack(side="left")
        ttk.Button(toolbar, text="Save Catalog", command=self.save, style="Save.TButton").pack(side="right")
        tabs = ttk.Notebook(root)
        tabs.pack(fill="both", expand=True, padx=12, pady=(0, 8))
        satchel_tab, stable_tab = ttk.Frame(tabs), ttk.Frame(tabs)
        tabs.add(satchel_tab, text="Satchel Manager")
        tabs.add(stable_tab, text="Stable Manager")
        self.satchel = SatchelManager(satchel_tab)
        self.stable = StableManagerApp(stable_tab)
        gun_tab = ttk.Frame(tabs)
        tabs.add(gun_tab, text="Gunsmith Manager")
        self.gunsmith = GunsmithManager(gun_tab)
        root.protocol("WM_DELETE_WINDOW", self.close)
        root.bind("<Control-s>", lambda _event: self.save())
        root.after(1, self.load)

    def load(self):
        try:
            self.set_catalog(Catalog(self.source.read_bytes()))
        except (OSError, ValueError) as exc:
            error = "Place catalog_sp.bak next to catalog_sp_editor.pyw." if isinstance(exc, FileNotFoundError) else str(exc)
            self.status.set("No catalog loaded")
            messagebox.showerror("Could Not Load Backup", error, parent=self.root)
            return
        self.saved_data = self.satchel.catalog.data
        self.status.set("")

    def set_catalog(self, catalog):
        self.satchel.catalog = catalog
        self.satchel.changes.clear()
        self.shop_model = ShopData(catalog)
        self.stable.load_catalog(catalog,self.shop_model)
        self.stable.on_change=self.refresh_shops
        self.gunsmith.load(self.shop_model)
        self.satchel.refresh(keep_selection=False)

    def refresh_shops(self):
        self.stable.sync_unlock()

    def combined_data(self, catalog):
        self.gunsmith.validate()
        stable_data = self.stable.render(catalog.data)
        if self.shop_model.changes or self.shop_model.removed or self.shop_model.unlocked:
            # Re-index after Stable Manager edits, because XML offsets can shift.
            model = self.shop_model if stable_data == catalog.data else ShopData(Catalog(stable_data))
            stable_data = model.render(self.shop_model.changes, self.shop_model.removed, self.shop_model.unlocked)
        return Catalog(stable_data).render(self.satchel.changes)

    def close(self):
        catalog = self.satchel.catalog
        dirty = False
        if catalog is not None:
            try:
                dirty = self.combined_data(catalog) != self.saved_data
            except ValueError:
                dirty = True
        if not dirty or messagebox.askokcancel("Unsaved Changes", "Discard unsaved changes?", parent=self.root):
            self.root.destroy()

    def save(self):
        catalog = self.satchel.catalog
        if catalog is None:
            return
        try:
            if self.target.exists() and self.target.samefile(self.source):
                raise OSError("The output file points to catalog_sp.bak.")
            previous = self.target.read_bytes() if self.target.exists() else None
            combined = self.combined_data(catalog)
            Catalog(combined)
            save_catalog(self.target, combined, previous)
        except (OSError, ValueError) as exc:
            messagebox.showerror("Could Not Save Catalog", str(exc), parent=self.root)
            return
        self.status.set("Saved catalog_sp.ymt")
        # Keep the source catalog and the stable controls so a removed horse
        # can still be restored during the current editing session.
        self.saved_data = combined


