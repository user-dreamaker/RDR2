def item_hash(name):
    value = 0
    for char in name.lower().encode("ascii"):
        value = ((value + char) * 1025) & 0xFFFFFFFF
        value ^= value >> 6
    value = (value * 9) & 0xFFFFFFFF
    value ^= value >> 11
    return (value * 32769) & 0xFFFFFFFF


def item_labels():
    labels = {}
    for line in ITEM_NAMES.strip().splitlines():
        if line.startswith("["):
            category = line[1:-1]
        else:
            labels[item_hash(line)] = (line, category)
    return labels


LABELS = item_labels()
CATEGORIES = ("All", "Provisions", "Tonics", "Ingredients", "Materials", "Kit", "Valuables", "Other")


@dataclass
class CatalogItem:
    item_id: int
    limits: tuple
    fields: tuple

    @property
    def hex_id(self):
        return "0x{:08X}".format(self.item_id)

    @property
    def label(self):
        return LABELS.get(self.item_id, (self.hex_id, "Other"))


def checked_limits(values):
    try:
        default, upgraded, legend = (min(int(value), 99) for value in values)
    except ValueError as exc:
        raise ValueError("Enter an integer for each limit.") from exc
    if not 1 <= default <= upgraded <= legend:
        raise ValueError("Enter limits in order: 1 ≤ Default ≤ Upgraded ≤ Legend.")
    return default, upgraded, legend


class Catalog:
    def __init__(self, data):
        self.data = data
        self.items = {}
        self.records = {}
        self._read_items()
        if not self.items:
            raise ValueError("No items with three recognized capacity limits were found.")

    def _read_items(self):
        root = re.match(rb'(?:\xef\xbb\xbf)?\s*(?:<\?xml[^?]*\?>\s*)?<(0x43D3D901|ItemDatabaseParser)(?:\s|>)', self.data)
        if root is None:
            raise ValueError("Use a text (XML) catalog, like the files used by Stable Manager.")
        named = root[1] == b"ItemDatabaseParser"
        item_path = NAMED_ITEM_PATH if named else HASHED_ITEM_PATH
        if named:
            normalized = self.data
        else:
            normalized = re.sub(rb"(<\/?)(0)(x43D3D901)(?=\s|>)", rb"\1_\3", self.data)
        parser = expat.ParserCreate()
        stack = []
        record_id = None
        record_start = 0
        duplicates = set()
        seen = set()

        def begin(name, attrs):
            nonlocal record_id, record_start
            stack.append(name)
            if len(stack) == len(item_path) and tuple(stack) == item_path:
                key = attrs.get("key", "")
                if HASH.fullmatch(key):
                    record_id = int(key, 16)
                elif named and re.fullmatch(r"[A-Za-z_][A-Za-z_0-9]*", key):
                    record_id = item_hash(key)
                record_start = parser.CurrentByteIndex

        def end(_name):
            nonlocal record_id
            if len(stack) == len(item_path) and record_id is not None:
                if record_id in seen:
                    duplicates.add(record_id)
                seen.add(record_id)
                end_tag = self.data.find(b">", parser.CurrentByteIndex)
                self.records[record_id] = (record_start, end_tag + 1)
                item = self._read_record(record_id, record_start, parser.CurrentByteIndex, named)
                if item:
                    self.items[record_id] = item
                record_id = None
            stack.pop()

        def no_dtd(*_args):
            raise ValueError("The catalog contains an unsupported XML declaration.")

        parser.StartElementHandler = begin
        parser.EndElementHandler = end
        parser.StartDoctypeDeclHandler = no_dtd
        try:
            parser.Parse(normalized, True)
        except expat.ExpatError as exc:
            raise ValueError("Invalid catalog on line {}.".format(exc.lineno)) from exc
        for item_id in duplicates:
            self.items.pop(item_id, None)
            self.records.pop(item_id, None)

    def _read_record(self, item_id, start, end, named):
        block_pattern = NAMED_BLOCK if named else RULE_BLOCK
        rule_pattern = NAMED_RULE if named else RULE
        record = XML_LITERAL.sub(lambda match: b" " * len(match[0]), self.data[start:end])
        blocks = block_pattern.finditer(record)
        block = next(blocks, None)
        if block is None or next(blocks, None):
            return None
        fields = [None, None, None]
        values = [0, 0, 0]
        for rule in rule_pattern.finditer(record, block.start(1), block.end(1)):
            tag = rule[2].decode("ascii")
            rule_hash = int(tag, 16) if HASH.fullmatch(tag) else item_hash(tag)
            field = RULE_TAGS.get(rule_hash)
            if field is None:
                continue
            value = int(rule[1])
            if fields[field] is not None or not (1 if field == 0 else 0) <= value <= 2147483647:
                return None
            fields[field] = (start + rule.start(1), start + rule.end(1))
            values[field] = value
        default, upgrade_bonus, legend_bonus = values
        if None in fields or sum(values) > 2147483647:
            return None
        limits = (default, default + upgrade_bonus, sum(values))
        return CatalogItem(item_id, limits, tuple(fields))

    def render(self, changes):
        patches = []
        for item_id, limits in changes.items():
            item = self.items[item_id]
            default, upgraded, legend = checked_limits(limits)
            for (start, end), value in zip(item.fields, (default, upgraded - default, legend - upgraded)):
                replacement = str(value).encode("ascii")
                if self.data[start:end] != replacement:
                    patches.append((start, end, replacement))
        if not patches:
            return self.data
        parts = []
        previous = 0
        for start, end, replacement in sorted(patches):
            parts.extend((self.data[previous:start], replacement))
            previous = end
        parts.append(self.data[previous:])
        return b"".join(parts)


def save_catalog(path, data, previous):
    if (path.read_bytes() if path.exists() else None) != previous:
        raise OSError("The output file changed before saving. Try saving again.")
    if previous == data:
        return
    fd, temp_name = tempfile.mkstemp(dir=str(path.parent), prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if (path.read_bytes() if path.exists() else None) != previous:
            raise OSError("The output file changed while saving.")
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def build_manager_header(parent, title):
    """Use one fixed header layout for every manager tab."""
    header = ttk.Frame(parent)
    header.pack(fill="x", padx=12, pady=(8, 8))
    # Reserve the same title width in every tab, including the longest title.
    title_font = tkfont.Font(root=parent, font=ttk.Style(parent).lookup("Title.TLabel", "font"))
    title_width = max(title_font.measure(name) for name in (
        "SATCHEL MANAGER", "STABLE MANAGER", "GUNSMITH MANAGER")) + 4
    header.columnconfigure(0, minsize=title_width)
    header.columnconfigure(1, weight=1)
    header.title_label = ttk.Label(header, text=title, style="Title.TLabel", anchor="w")
    header.title_label.grid(row=0, column=0, sticky="w")
    header.rule = ttk.Separator(header, orient="horizontal")
    header.rule.grid(row=0, column=1, sticky="ew", padx=12)
    # The same embedded image and dimensions are used without rescaling.
    top = parent.winfo_toplevel()
    if not hasattr(top, "_manager_banner"):
        top._manager_banner = tk.PhotoImage(master=top, data=WESTERN_BANNER)
    header.banner = top._manager_banner
    header.banner_label = ttk.Label(header, image=header.banner)
    header.banner_label.grid(row=0, column=2, sticky="e")
    return header


class SatchelManager:
    def __init__(self, root):
        self.root = root
        self.catalog = None
        self.changes = {}
        self.visible = []
        self.search = tk.StringVar()
        self.category = tk.StringVar(value=CATEGORIES[0])
        self.status = tk.StringVar(value="Loading catalog_sp.bak…")
        self.values = [tk.StringVar() for _ in range(3)]
        self.column_filters = {}
        self.sort_column = "item"
        self.sort_reverse = False
        self.build()

    def build(self):
        style = ttk.Style()
        style.theme_use("clam")
        background, surface, text, accent = "#090807", "#100d0c", "#e9dccb", "#780706"
        border, hot = "#a51b18", "#b51b17"
        families = set(tkfont.families(self.root))
        western = next((name for name in ("Rockwell Extra Bold", "Rockwell", "Georgia", "DejaVu Serif") if name in families), "TkDefaultFont")
        body = "Segoe UI" if "Segoe UI" in families else "TkDefaultFont"
        self.root.winfo_toplevel().configure(background=background)
        self.root.option_add("*TCombobox*Listbox.background", surface)
        self.root.option_add("*TCombobox*Listbox.foreground", text)
        self.root.option_add("*TCombobox*Listbox.selectBackground", accent)
        self.root.option_add("*TCombobox*Listbox.selectForeground", text)
        style.configure(".", background=background, foreground=text, fieldbackground=surface,
                        bordercolor=border, lightcolor=background, darkcolor=background,
                        troughcolor=background, arrowcolor=text, insertcolor=text, font=(body, 10))
        style.configure("TButton", background=surface, padding=(9, 5), borderwidth=1)
        style.map("TButton", background=[("disabled", "#171311"), ("pressed", accent), ("active", hot)],
                  foreground=[("disabled", "#82766b")])
        for widget in ("TEntry", "TSpinbox", "TCombobox"):
            style.configure(widget, background=surface, padding=3)
            style.map(widget, fieldbackground=[("disabled", "#171311"), ("!disabled", surface)],
                      foreground=[("disabled", "#82766b"), ("!disabled", text)])
        style.map("TCombobox", selectbackground=[("readonly", surface)], selectforeground=[("readonly", text)])
        style.configure("TNotebook", tabmargins=(0, 0, 0, 0), borderwidth=1)
        style.configure("TNotebook.Tab", padding=(13, 7), background=surface, font=(western, 10, "bold"))
        style.map("TNotebook.Tab", expand=[("selected", (0, 0, 0, 0))],
                  background=[("selected", accent), ("active", hot)])
        style.configure("Stable.TLabel", font=(body, 10))
        style.configure("StableHeader.TLabel", background=accent, foreground=text, font=(western, 10, "bold"), padding=(8, 6))
        style.configure("StableGroup.TLabel", background="#480908", foreground=text, font=(western, 10, "bold"), padding=(8, 5))
        style.configure("Stable.TFrame", background=background)
        style.configure("Stable.TEntry", font=(body, 10), padding=(4, 2))
        style.configure("Stable.TCheckbutton", padding=2, indicatorsize=17, indicatormargin=2)
        # A high-contrast, consistent checkbox on Windows and Linux.
        images = []
        for checked, disabled in ((False,False),(True,False),(False,True),(True,True)):
            img = tk.PhotoImage(master=self.root, width=18, height=18)
            img.put("#66544b" if disabled else "#e9dccb", to=(0,0,18,18))
            img.put("#171311" if disabled else "#100d0c", to=(2,2,16,16))
            if checked:
                img.put("#66544b" if disabled else "#780706", to=(2,2,16,16))
                ink="#99867a" if disabled else "#fff5e8"
                for x,y in [(4,8),(5,9),(6,10),(7,11),(8,10),(9,9),(10,8),(11,7),(12,6),(13,5)]:
                    img.put(ink,to=(x,y,x+2,y+2))
            images.append(img)
        self.check_images=images
        style.element_create("WesternCheck.indicator", "image", images[0], ("disabled", "selected", images[3]), ("disabled", images[2]), ("selected", images[1]), sticky="")
        style.layout("Stable.TCheckbutton", [("Checkbutton.padding", {"sticky":"nswe", "children":[("WesternCheck.indicator", {"side":"left", "sticky":""}), ("Checkbutton.label", {"side":"left", "sticky":"nswe"})]})])
        style.configure("Save.TButton", background=accent, padding=(14, 6), font=(western, 10, "bold"))
        style.configure("Accent.TButton", background=accent, font=(body, 10, "bold"))
        for widget in ("Save.TButton", "Accent.TButton"):
            style.map(widget, background=[("disabled", "#171311"), ("pressed", "#580403"), ("active", hot)])
        style.configure("Treeview.Heading", background=accent, foreground=text, font=(western, 10, "bold"),
                        relief="flat", padding=(5, 7), bordercolor=border, lightcolor=accent, darkcolor=accent)
        style.map("Treeview.Heading", background=[("pressed", "#580403"), ("active", hot)])
        # Draw the dashed rule as part of the ttk heading itself. Tk tiles
        # image elements horizontally, so it is present on the first paint
        # and follows column resizing without any overlay or timing callbacks.
        self.heading_rule_image = tk.PhotoImage(master=self.root, width=8, height=1)
        self.heading_rule_image.put("#000000", to=(0, 0, 5, 1))
        style.element_create("SatchelRule.divider", "image", self.heading_rule_image, sticky="ew")
        heading_layout = style.layout("Treeview.Heading")
        for element, options in heading_layout:
            if element.endswith(".border") and "children" in options:
                options["children"].insert(0, ("SatchelRule.divider", {"side": "bottom", "sticky": "ew"}))
                break
        style.layout("Satchel.Treeview.Heading", heading_layout)
        style.configure("Treeview", rowheight=26, background=background, fieldbackground=background,
                        borderwidth=1, font=(body, 10))
        style.map("Treeview", background=[("selected", accent)], foreground=[("selected", "#fff5e8")])
        style.configure("Vertical.TScrollbar", background=accent, troughcolor=background, arrowsize=14,
                        bordercolor=border, lightcolor=accent, darkcolor=accent)
        style.map("Vertical.TScrollbar", background=[("active", hot), ("pressed", "#580403")])
        style.configure("Title.TLabel", font=(western, 23, "bold"))
        style.configure("Filter.TFrame", background=background, borderwidth=1, relief="solid", bordercolor=border)
        style.configure("TSeparator", background=border)
        style.configure("TLabelFrame", bordercolor=border, relief="solid", borderwidth=1)
        style.configure("TLabelFrame.Label", font=(western, 11, "bold"))
        style.configure("File.TLabel", foreground="#bfb0a4")
        style.configure("Status.TLabel", foreground="#bfb0a4", font=(body, 9))

        self.header = build_manager_header(self.root, "SATCHEL MANAGER")
        frame = ttk.Frame(self.root, padding=(12, 0, 12, 8))
        frame.pack(fill="both", expand=True)
        filters = ttk.Frame(frame, style="Filter.TFrame", padding=(10, 7))
        filters.pack(fill="x", pady=(0, 8))
        ttk.Label(filters, text="Category").pack(side="left")
        combo = ttk.Combobox(filters, values=CATEGORIES, textvariable=self.category, state="readonly", width=17)
        combo.pack(side="left", padx=(6, 14))
        combo.bind("<<ComboboxSelected>>", self.refresh)
        ttk.Label(filters, text="Search item or hash").pack(side="left")
        ttk.Entry(filters, textvariable=self.search, width=24).pack(side="left", fill="x", expand=True, padx=(6, 10))
        ttk.Button(filters, text="Clear Filters", command=self.clear_filters).pack(side="right")
        self.search.trace_add("write", self.refresh)

        table = ttk.Frame(frame)
        table.pack(fill="both", expand=True)
        columns = ("item", "category", "hash", "default", "upgraded", "legend")
        self.tree = ttk.Treeview(table, show="headings", columns=columns, selectmode="extended", style="Satchel.Treeview")
        scrollbar = ttk.Scrollbar(table, orient="vertical", command=self.tree.yview)
        self.tree.configure(yscrollcommand=scrollbar.set)
        self.tree.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
        self.headings = (
            ("item", "Item", 300), ("category", "Category", 132), ("hash", "Hash", 115),
            ("default", "Default", 90), ("upgraded", "Upgraded", 110), ("legend", "Legend", 90),
        )
        for column, label, width in self.headings:
            alignment = "w" if column in ("item", "category", "hash") else "center"
            self.tree.heading(column, text=label, anchor=alignment,
                              command=lambda col=column: self.toggle_sort(col))
            self.tree.column(column, width=width, minwidth=width, anchor=alignment, stretch=column == "item")
        self.tree.tag_configure("changed", foreground="#edbc61")
        self.tree.tag_configure("alternate", background="#100d0c")
        self.tree.bind("<<TreeviewSelect>>", self.selection_changed)
        self.tree.bind("<Control-a>", self.select_visible)
        self.tree.bind("<Button-3>", self.heading_context_menu)
        editor = ttk.LabelFrame(frame, text="Capacity Limits", padding=(10, 8))
        editor.pack(fill="x", pady=(12, 8))
        for index, (label, value) in enumerate(zip(("Default", "Upgraded", "Legend"), self.values)):
            ttk.Label(editor, text=label).grid(row=0, column=2 * index, padx=(0, 5), sticky="w")
            field = ttk.Spinbox(editor, from_=1, to=99, width=5, textvariable=value)
            field.grid(row=0, column=2 * index + 1, padx=(0, 12))
            field.bind("<Return>", lambda _event: self.apply())
        self.apply_button = ttk.Button(editor, text="Apply to Selection", command=self.apply)
        self.apply_button.grid(row=0, column=6, padx=(0, 6))
        self.all_button = ttk.Button(editor, text="Apply to Filtered", command=lambda: self.apply(True), style="Accent.TButton")
        self.all_button.grid(row=0, column=7, padx=(0, 6))
        self.revert_button = ttk.Button(editor, text="Revert Selection", command=self.revert)
        self.revert_button.grid(row=0, column=8)
        ttk.Label(frame, textvariable=self.status, style="Status.TLabel").pack(fill="x")
        self.update_buttons()

    def update_buttons(self):
        selected = self.tree.selection()
        for button, enabled in (
            (self.apply_button, bool(selected)),
            (self.all_button, bool(self.visible)),
            (self.revert_button, any(int(i) in self.changes for i in selected)),
        ):
            button.configure(state="normal" if enabled else "disabled")

    def clear_filters(self):
        self.column_filters.clear()
        self.category.set(CATEGORIES[0])
        self.search.set("")  # The trace refreshes the table once.

    def toggle_sort(self, column):
        # A new column starts ascending; repeated clicks reverse its order.
        self.set_sort(column, not self.sort_reverse if self.sort_column == column else False)

    def heading_context_menu(self, event):
        if self.tree.identify_region(event.x, event.y) != "heading":
            return
        index = int(self.tree.identify_column(event.x)[1:]) - 1
        if 0 <= index < len(self.headings):
            self.heading_menu(self.headings[index][0])
            return "break"

    def heading_menu(self, column):
        menu = tk.Menu(self.root, tearoff=False, background="#100d0c", foreground="#e9dccb",
                       activebackground="#780706", activeforeground="#fff5e8", relief="flat", borderwidth=1)
        menu.add_command(label="Set filter…", command=lambda: self.edit_column_filter(column))
        if self.catalog is not None and column in ("category", "default", "upgraded", "legend"):
            idx = [c[0] for c in self.headings].index(column)
            values = sorted({self.row_values(item)[idx] for item in self.catalog.items.values()})
            if len(values) <= 30:
                options = tk.Menu(menu, tearoff=False, background="#100d0c", foreground="#e9dccb",
                                  activebackground="#780706", activeforeground="#fff5e8")
                for value in values:
                    options.add_command(label=str(value), command=lambda v=value: self.set_column_filter(column, str(v), True))
                menu.add_cascade(label="Filter by value", menu=options)
        menu.add_command(label="Clear column filter", command=lambda: self.set_column_filter(column, ""),
                         state="normal" if column in self.column_filters else "disabled")
        menu.add_command(label="Clear all filters", command=self.clear_filters)
        try:
            menu.tk_popup(self.tree.winfo_pointerx(), self.tree.winfo_pointery())
        finally:
            menu.grab_release()

    def set_sort(self, column, reverse):
        self.sort_column, self.sort_reverse = column, reverse
        self.refresh()

    def set_column_filter(self, column, value, exact=False):
        value = value.strip()
        if value:
            self.column_filters[column] = (value, exact)
        else:
            self.column_filters.pop(column, None)
        self.refresh()

    def edit_column_filter(self, column):
        dialog = tk.Toplevel(self.root)
        dialog.title("Filter " + column.title())
        dialog.configure(background="#090807")
        dialog.transient(self.root.winfo_toplevel())
        dialog.resizable(False, False)
        panel = ttk.Frame(dialog, padding=15)
        panel.pack(fill="both", expand=True)
        numeric = column in ("default", "upgraded", "legend")
        ttk.Label(panel, text="Enter an exact capacity (e.g. 99)" if numeric else "Enter text to match (case insensitive)").pack(anchor="w")
        value = tk.StringVar(value=self.column_filters.get(column, ("", False))[0])
        field = ttk.Entry(panel, textvariable=value, width=35)
        field.pack(fill="x", pady=8)
        def accept(_event=None):
            query = value.get().strip()
            if numeric and query and not query.isdecimal():
                messagebox.showerror("Invalid filter", "Enter a whole number.", parent=dialog)
                return
            if numeric and query:
                query = str(int(query))
            self.set_column_filter(column, query, numeric)
            dialog.destroy()
        buttons = ttk.Frame(panel)
        buttons.pack(fill="x")
        ttk.Button(buttons, text="Apply", style="Accent.TButton", command=accept).pack(side="right")
        ttk.Button(buttons, text="Cancel", command=dialog.destroy).pack(side="right", padx=6)
        dialog.bind("<Return>", accept)
        dialog.bind("<Escape>", lambda _event: dialog.destroy())
        dialog.update_idletasks()
        dialog.geometry("+{}+{}".format(self.tree.winfo_rootx()+30, self.tree.winfo_rooty()+35))
        dialog.grab_set()
        field.focus_set()
        field.selection_range(0, "end")

    def row_values(self, item):
        name, group = item.label
        return (name, group, item.hex_id) + self.changes.get(item.item_id, item.limits)

    def refresh(self, *_args, keep_selection=True):
        selection = self.tree.selection() if keep_selection else ()
        self.tree.delete(*self.tree.get_children())
        self.visible = []
        for column, label, _width in self.headings:
            indicator = " ▲" if column == self.sort_column and not self.sort_reverse else " ▼" if column == self.sort_column else ""
            self.tree.heading(column, text=label + (" *" if column in self.column_filters else "") + indicator)
        if self.catalog is None:
            self.update_buttons()
            return
        query = self.search.get().strip().casefold().replace("_", " ")
        category = self.category.get()
        columns = [c[0] for c in self.headings]
        active = [(columns.index(col), value.casefold(), exact) for col, (value, exact) in self.column_filters.items()]
        rows = []
        for item in self.catalog.items.values():
            row = self.row_values(item)
            name, group, hex_id = row[:3]
            if category != CATEGORIES[0] and category != group:
                continue
            searchable = (name + " " + hex_id).casefold().replace("_", " ")
            if query and not all(term in searchable for term in query.split()):
                continue
            if any((str(row[idx]).casefold() != value if exact else value not in str(row[idx]).casefold())
                   for idx, value, exact in active):
                continue
            rows.append((item.item_id, row))
        sort_index = columns.index(self.sort_column)
        def sort_key(record):
            value = record[1][sort_index]
            return (0, value) if isinstance(value, int) else (1, str(value).casefold())
        rows.sort(key=sort_key, reverse=self.sort_reverse)
        for index, (item_id, row) in enumerate(rows):
            self.visible.append(item_id)
            tags = (("changed",) if item_id in self.changes else ()) + (("alternate",) if index % 2 else ())
            self.tree.insert("", "end", iid=str(item_id), values=row, tags=tags)
        selected = [i for i in selection if self.tree.exists(i)]
        if selected:
            self.tree.selection_set(selected)
        self.update_status()

    def update_status(self):
        self.status.set("{} of {} items shown  •  {} item overrides".format(
            len(self.visible), len(self.catalog.items), len(self.changes)))
        self.update_buttons()

    def selection_changed(self, _event):
        selected = self.tree.selection()
        if len(selected) == 1:
            item = self.catalog.items[int(selected[0])]
            for field, value in zip(self.values, self.changes.get(item.item_id, item.limits)):
                field.set(str(value))
        self.update_buttons()

    def select_visible(self, _event):
        self.tree.selection_set(self.tree.get_children())
        return "break"

    def apply(self, all_visible=False):
        ids = self.visible if all_visible else [int(i) for i in self.tree.selection()]
        if not ids:
            return
        try:
            limits = checked_limits([value.get() for value in self.values])
        except ValueError as exc:
            messagebox.showerror("Invalid Limits", str(exc), parent=self.root)
            return
        if all_visible and len(ids) > 1:
            if not messagebox.askyesno("Edit Filtered Items", "Apply these limits to {} items?".format(len(ids)), parent=self.root):
                return
        for item_id in ids:
            if limits == self.catalog.items[item_id].limits:
                self.changes.pop(item_id, None)
            else:
                self.changes[item_id] = limits
        for field, value in zip(self.values, limits):
            field.set(str(value))
        self.refresh()

    def revert(self):
        for item_id in self.tree.selection():
            self.changes.pop(int(item_id), None)
        self.refresh()
        self.selection_changed(None)

